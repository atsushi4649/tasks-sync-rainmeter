[Variables]
; ===== Tasks Sync settings =====
; Language: ja / en
Language=ja
; Widget width (px)
Width=320
; Max number of tasks shown
MaxTasks=15
; Auto sync interval (minutes)
SyncMinutes=5

; Fonts  (Windows 10: set IconFont=Segoe MDL2 Assets)
Font=Segoe UI
IconFont=Segoe Fluent Icons
FontSize=10
FontSizeSmall=8
FontSizeTitle=12

; Colors (R,G,B,Alpha)
Radius=8
ColorBG=32,32,32,225
ColorBorder=255,255,255,28
ColorInputBG=45,45,45,255
ColorText=255,255,255,235
ColorSub=255,255,255,140
ColorFaint=255,255,255,70
ColorAccent=96,205,255,255
ColorAccentSoft=96,205,255,70
ColorDanger=255,110,110,255
