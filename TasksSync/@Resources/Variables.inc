[Variables]
; ===== Tasks Sync settings =====
; Language: ja / en
Language=ja
; Max number of tasks shown
MaxTasks=15
; Auto sync interval (minutes)
SyncMinutes=5

; ----- Size (defaults match Rainmeter's illustro skins) -----
Width=210
PadX=10
HeaderH=34
RowH=20
FooterH=30
; transparent margin around the panel (illustro: 5)
Inset=5
Radius=4

; ----- Fonts -----
Font=Trebuchet MS
; Windows 10: Segoe MDL2 Assets
IconFont=Segoe Fluent Icons
FontSize=8
FontSizeSmall=7
FontSizeTitle=10
; Bold / Normal
TextStyle=Bold
; Shadow / None
TextEffect=Shadow
; Upper / None
TitleCase=Upper

; ----- Colors (R,G,B,Alpha) -----
ColorBG=0,0,0,140
ColorHeaderBG=0,0,0,175
ColorBorder=103,103,103,79
ColorLine=255,255,255,0
ColorShadow=0,0,0,20
ColorInputBG=40,40,40,255
ColorText=255,255,255,205
ColorSub=255,255,255,140
ColorFaint=255,255,255,60
ColorAccent=235,170,0,255
ColorAccentSoft=235,170,0,70
ColorDanger=255,110,110,255
